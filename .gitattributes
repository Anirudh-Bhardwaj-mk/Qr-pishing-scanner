    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');

        body {
            background-color: #fdfbf7;
            color: #2c3e50;
            font-family: 'Inter', sans-serif;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #fdfbf7;
        }
        ::-webkit-scrollbar-thumb {
            background: #c7d7c7;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #a3bfa3;
        }

        .drop-zone {
            transition: all 0.25s ease-in-out;
            background-image: url("data:image/svg+xml,%3csvg width='100%25' height='100%25' xmlns='http://www.w3.org/2000/svg'%3e%3crect width='100%25' height='100%25' fill='none' rx='16' ry='16' stroke='%23A3BFA3FF' stroke-width='2' stroke-dasharray='8%2c 8' stroke-dashoffset='0' stroke-linecap='square'/%3e%3c/svg%3e");
        }
        .drop-zone.dragover {
            background-color: #e3ebe3;
            transform: scale(1.005);
        }

        /* Radar scan effect */
        @keyframes scanLine {
            0% { top: 0%; opacity: 0.8; }
            50% { opacity: 1; }
            100% { top: 100%; opacity: 0.8; }
        }
        .scanning-line {
            position: absolute;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, #678d67, #2c3e50, #678d67, transparent);
            box-shadow: 0 0 12px #678d67;
            animation: scanLine 2s ease-in-out infinite alternate;
        }

        /* Meter gauge styling */
        .gauge-circle {
            transition: stroke-dashoffset 0.8s ease-in-out, stroke 0.5s ease;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-sage-200 selection:text-sage-800">

