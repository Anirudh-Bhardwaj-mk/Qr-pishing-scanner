    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sage: {
                            50: '#f4f7f4',
                            100: '#e3ebe3',
                            200: '#c7d7c7',
                            300: '#a3bfa3',
                            400: '#8aaa8a',
                            500: '#678d67',
                            600: '#527352',
                            700: '#425b42',
                            800: '#374a37',
                        },
                        cream: {
                            50: '#fffefc',
                            100: '#fdfbf7',
                            200: '#f9f5ec',
                            300: '#f3ebd9',
